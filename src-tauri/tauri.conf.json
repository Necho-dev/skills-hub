{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SkillsHub",
  "version": "0.1.1",
  "identifier": "com.skillshub.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SkillsHub",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:skillshub.db"]
    },
    "updater": {
      "endpoints": [
        "https://github.com/Necho-dev/skills-hub/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4NjAwMjFFOEZBNEY0OTcKUldTWDlLU1BIZ0pnU0YzWFc4d0NrUmpxTVpFZnhiYnIwRit3T3VUc3h2eGpNb2J0b3RnNmRFbm8K"
    }
  }
}
